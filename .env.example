# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# --- everything below is optional ---

# Register the slash commands in a single guild (instant) instead of globally
# (a few minutes on first publish). Handy while developing.
#DEV_GUILD_ID=

# Where subscriptions created with /trending subscribe are persisted.
#DATA_DIR=/data

# Optional declarative config file (see config.example.yaml).
#CONFIG_PATH=/config/config.yaml

# HTTP health endpoint; 0 disables it.
#HEALTH_PORT=8080

# trace | debug | info | warn | error | fatal
#LOG_LEVEL=info
# Human-readable logs instead of JSON (needs the dev dependencies).
#LOG_PRETTY=false

# Time zone used by schedules that do not set their own.
#TZ=Europe/Paris
#DEFAULT_TIMEZONE=Europe/Paris
#DEFAULT_LIMIT=5
#DEFAULT_STYLE=embed

# Set to false to stop the bot from (re)publishing its slash commands at boot.
#REGISTER_COMMANDS=true
