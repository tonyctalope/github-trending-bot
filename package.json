{
  "name": "github-trending-bot",
  "version": "1.0.0",
  "description": "Discord bot that posts GitHub trending repositories (daily / weekly / monthly) to one or more channels",
  "license": "MIT",
  "author": "tonyctalope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyctalope/github-trending-bot.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "canary": "tsx scripts/canary.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "croner": "10.0.1",
    "discord.js": "14.27.0",
    "pino": "10.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
